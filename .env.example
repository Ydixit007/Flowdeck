# MongoDB
MONGODB_URI=mongodb://localhost:27017/flowdeck

# Session signing secret (openssl rand -base64 48)
AUTH_SECRET=replace-me-with-a-long-random-string

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron auth for /api/cron/reminders
CRON_SECRET=replace-me

# SmolBusiness admin dashboard (writes: announcements, resolvedAt on contacts/feature requests, seller deletion)
SMOL_MONGODB_URI=
SMOL_DB_NAME=SmolBusiness_Test
# Comma-separated Flowdeck account emails allowed to open /smol
SMOL_ADMIN_EMAILS=
# Seller deletion: same R2 bucket + storefront Vercel project as smolBusiness-backend (R2_*, STOREFRONT_VERCEL_*)
SMOL_R2_ACCOUNT_ID=
SMOL_R2_ACCESS_KEY_ID=
SMOL_R2_SECRET_ACCESS_KEY=
SMOL_R2_BUCKET=
SMOL_VERCEL_TOKEN=
SMOL_VERCEL_PROJECT_ID=
SMOL_VERCEL_TEAM_ID=

# PostHog personal API key (read-only query scope) for the SmolBusiness analytics tab
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
