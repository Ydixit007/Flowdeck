# MongoDB
MONGODB_URI=mongodb://localhost:27017/flowdeck

# Session signing secret (openssl rand -base64 48)
AUTH_SECRET=replace-me-with-a-long-random-string

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron auth for /api/cron/reminders
CRON_SECRET=replace-me
